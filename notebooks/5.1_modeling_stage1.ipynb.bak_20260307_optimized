  {
   "cell_type": "code",
   "execution_count": null,
   "id": "latent_code",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-02-24T19:31:04.845874Z",
     "iopub.status.busy": "2026-02-24T19:31:04.845709Z",
     "iopub.status.idle": "2026-02-24T19:31:05.097175Z",
     "shell.execute_reply": "2026-02-24T19:31:05.096881Z"
    }
   },
   "outputs": [],
   "source": [
    "# Generate out-of-fold (OOF) probabilities for ALL rows (leakage-safe for Stage 2)\n",
    "print(\"Generating OOF Stage 1 probabilities (5-fold Stratified CV)...\")\n",
    "\n",
    "class_ids = np.array(sorted(CLASS_NAMES.keys()))\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "oof_proba = np.full((len(X), len(class_ids)), np.nan, dtype=float)\n",
    "\n",
    "for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), start=1):\n",
    "    fold_model = clone(best_model)\n",
    "    fold_model.fit(X.iloc[tr_idx], y.iloc[tr_idx])\n",
    "\n",
    "    fold_pred = fold_model.predict_proba(X.iloc[va_idx])\n",
    "    fold_class_to_col = {cls: i for i, cls in enumerate(fold_model.classes_)}\n",
    "\n",
    "    for out_col, cls in enumerate(class_ids):\n",
    "        if cls in fold_class_to_col:\n",
    "            oof_proba[va_idx, out_col] = fold_pred[:, fold_class_to_col[cls]]\n",
    "        else:\n",
    "            oof_proba[va_idx, out_col] = 0.0\n",
    "\n",
    "    print(f\"  Fold {fold}: train={len(tr_idx):,}, valid={len(va_idx):,}\")\n",
    "\n",
    "if np.isnan(oof_proba).any():\n",
    "    raise ValueError(\"OOF probability matrix has NaNs. Check CV loop/class mapping.\")\n",
    "\n",
    "# Normalize rows defensively\n",
    "row_sum = oof_proba.sum(axis=1, keepdims=True)\n",
    "oof_proba = np.divide(oof_proba, np.clip(row_sum, 1e-12, None))\n",
    "\n",
    "# Refit best model on full data for optional future inference\n",
    "global_stage1_model = clone(best_model)\n",
    "global_stage1_model.fit(X, y)\n",
    "\n",
    "# Store per-class OOF probabilities\n",
    "prob_cols = []\n",
    "for col_idx, cls in enumerate(class_ids):\n",
    "    col_name = f'PROB_{CLASS_NAMES[cls].upper()}'\n",
    "    df[col_name] = oof_proba[:, col_idx]\n",
    "    prob_cols.append(col_name)\n",
    "\n",
    "# Latent Risk Score: weighted sum reflecting escalation risk and persistence\n",
    "weight_map = {\n",
    "    0: 0, 1: 0, 2: 1, 3: 3,\n",
    "    4: 0, 5: 1, 6: 2,\n",
    "    7: 0, 8: 2, 9: 3,\n",
    "}\n",
    "weights = np.array([weight_map[c] for c in class_ids], dtype=float)\n",
    "df['LATENT_RISK_SCORE'] = oof_proba @ weights\n",
    "\n",
    "# Predicted class from OOF probabilities (used by Stage 2 routing)\n",
    "df['STAGE1_PRED_CLASS'] = class_ids[oof_proba.argmax(axis=1)]\n",
    "\n",
    "print(\"=== Leakage-safe latent features generated ===\")\n",
    "print()\n",
    "print(f\"Probability Distributions ({len(class_ids)} classes):\")\n",
    "for col in prob_cols:\n",
    "    print(f\"  {col}: mean={df[col].mean():.3f}, std={df[col].std():.3f}\")\n",
    "print()\n",
    "print(\"LATENT_RISK_SCORE:\")\n",
    "print(f\"  mean={df['LATENT_RISK_SCORE'].mean():.3f}, std={df['LATENT_RISK_SCORE'].std():.3f}\")\n",
    "print(f\"  range: [{df['LATENT_RISK_SCORE'].min():.3f}, {df['LATENT_RISK_SCORE'].max():.3f}]\")\n",
    "\n",
    "agreement = (df['STAGE1_PRED_CLASS'] == df['RISK_TIER']).mean()\n",
    "print()\n",
    "print(f\"OOF class agreement vs true RISK_TIER: {agreement:.3f}\")"
   ]
